# Copy to .env.local and fill in after running contracts/script/DeployFactory.s.sol,
# contracts/script/DeployCandidateTargets.s.sol, and
# contracts/script/DeployReasoningLog.s.sol.
# (Vite only exposes VITE_-prefixed vars to client code, and .env.local is gitignored.)

VITE_FACTORY_ADDRESS=
VITE_PAID_API_ADDRESS=
VITE_NEWS_API_ADDRESS=
VITE_MARKET_DATA_API_ADDRESS=
VITE_REASONING_LOG_ADDRESS=
