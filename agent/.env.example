# Copy to .env and fill in.

# The PasskeyAccount address that granted this agent a session key (from the frontend).
ACCOUNT_ADDRESS=

# The PaidAPI address (from contracts/script/DeployFactory.s.sol output).
PAID_API_ADDRESS=

# The ReasoningLog address (from contracts/script/DeployReasoningLog.s.sol output).
REASONING_LOG_ADDRESS=

# This agent's own session key — generate with, e.g.:
#   node -e "console.log(require('viem/accounts').generatePrivateKey())"
# then grant that key's address a session key via the frontend before running.
# This key also pays its own gas, so fund its address via https://faucet.monad.xyz.
SESSION_KEY_PRIVATE_KEY=

# Which model backend makes the spend decision: "ollama" (default, free, local —
# requires `ollama serve` running with OLLAMA_MODEL pulled) or "anthropic" (needs
# real API credit). Swapping providers requires no code change.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Only used when LLM_PROVIDER=anthropic. Resolved automatically by the Anthropic
# SDK if unset (ANTHROPIC_API_KEY, an `ant auth login` profile, etc.).
ANTHROPIC_API_KEY=

# Optional: run continuously every N seconds instead of once and exiting.
LOOP_INTERVAL_SECONDS=
